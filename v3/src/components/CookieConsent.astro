---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '../assets/styles/ccElegantBlack.css';
---

<script>
  import { run, showPreferences } from 'vanilla-cookieconsent';
  import { config } from './CookieConsentConfig';

  // toggle custom black theme
  document.body.classList.add('cc--elegant-black');

  // run() has to be called on every page load, not only before the banner is first
  // answered: re-applying a stored consent is what calls the analytics service's
  // onAccept, and that is now the only thing that loads Google Analytics. The library
  // keeps its own record of whether the banner was answered and decides on its own
  // whether to show it again.
  run(config);

  // Consent can only be withdrawn if there is a way back into the preferences modal.
  // The footer links to this anchor.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('a[href="#cookie-settings"]')) {
      event.preventDefault();
      showPreferences();
    }
  });
</script>
