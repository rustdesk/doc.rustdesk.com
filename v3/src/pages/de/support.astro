---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'RustDesk Support - Hilfe & Dokumentation für Remote-Desktop-Software',
  description: 'Support für RustDesk, den Open-Source-Remote-Desktop: Bugs auf GitHub melden, Community auf Discord, E-Mail-Tickets für selbst gehosteten RustDesk Server Pro.',
  keywords: 'rustdesk support, remote desktop hilfe, selbst gehostete unterstützung, remote access dokumentation, rustdesk fehlerbehebung, remote desktop setup hilfe',
  author: 'RustDesk Team',
};
---

<Layout metadata={metadata} i18n>
  <Features2
    title="Wir sind für Sie da!"
    items={[
      {
        title: 'Fehler melden',
        description: `Einen Fehler gefunden? Melden Sie ihn gern in unseren GitHub-Issues.`,
      },
      {
        title: 'Community-Support',
        description: 'Treten Sie unserem Discord-Server bei, um Hilfe und bewährte Vorgehensweisen zu finden.',
      },
      {
        title: 'Ticket für Pro-Nutzer',
        description: 'Schreiben Sie uns eine E-Mail, wenn bei der Nutzung von RustDesk Server Pro Probleme auftreten.',
      },
      {
        title: 'GitHub',
        description: '<a target="_blank" href="https://github.com/rustdesk/rustdesk/issues">Issue eröffnen</a>',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Discord',
        description: '<a target="_blank" href="https://discord.com/invite/nDceKgxnkV">Unserem Server beitreten</a>',
        icon: 'tabler:brand-discord',
      },
      {
        title: 'E-Mail',
        description: '<a href="mailto:support@rustdesk.com">support@rustdesk.com</a>',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
