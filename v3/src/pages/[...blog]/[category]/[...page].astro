    pricing: 'شرح ترخيص RustDesk Server Pro ذاتي الاستضافة: ما الذي يُحتسب جهازًا مُدارًا، وكيف يُعدّ المستخدمون والاتصالات المتزامنة، وكيف تتم الترقية في منتصف الاشتراك.',
    security:
      'أمان سطح المكتب البعيد بلا ادعاءات مطلقة: كيف تكشف عمليات الاحتيال، ومراجعات لأمان AnyDesk وChrome Remote Desktop، وسيادة البيانات وGDPR عبر الاستضافة الذاتية.',
    troubleshooting: 'حلول لمشكلات سطح المكتب البعيد: توقف RustDesk عند انتظار الصورة بعد الاتصال، وتنبيهات الاستخدام التجاري في AnyDesk وTeamViewer، ومتى تصعّد المشكلة.',
  },
};
// Category slugs are transliterated per language (/zh-cn/category/an1-quan2,
// /ja/category/gaido), but the descriptions above are keyed by the English
// slug, so a direct lookup only ever matched the Latin-script languages.
// Resolve the English key through this category's posts and their English
// translations.
const englishPosts = await fetchPosts('en');
const categoryKey =
  categorySlug in localizedCategoryDescriptions.en
    ? categorySlug
    : (page.data
        .map((post) => englishPosts.find((en) => en.translationKey === post.translationKey)?.category?.slug)
        .find(Boolean) ?? categorySlug);
const categoryDescription =
  localizedCategoryDescriptions[lang]?.[categoryKey] ?? localizedCategoryDescriptions.en[categoryKey];
const localePaths = (Object.keys(LOCALES) as Lang[]).map((targetLang) => ({
  lang: targetLang,
  path: getBlogPermalink(targetLang),
}));

const metadata = {
  title: `${copy.category}: ${category.title}${currentPage > 1 ? ` — ${copy.page} ${currentPage}` : ''}`,
  description: categoryDescription ?? `${copy.subtitle} ${copy.category}: ${category.title}.`,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata} i18n lang={lang} localePaths={localePaths} alternateLinks={[]}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>{category.title}</Headline>
    {
      categoryDescription && currentPage === 1 && (
        <p class="mx-auto mb-10 max-w-3xl text-center text-lg text-muted dark:text-slate-400">{categoryDescription}</p>
      )
    }
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} lang={lang} />
  </section>
</Layout>
